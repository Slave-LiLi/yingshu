<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">#EDF3F7</item>
        <item name="android:navigationBarColor">#EDF3F7</item>
        <item name="android:windowBackground">#EDF3F7</item>
        <item name="android:colorBackground">#EDF3F7</item>
        <item name="android:colorBackgroundFloating">#FCFDFF</item>
        <item name="android:textColorPrimary">#102438</item>
        <item name="android:textColorSecondary">#425B70</item>
        <item name="android:colorAccent">#00686C</item>
        <item name="android:colorControlNormal">#425B70</item>
        <item name="android:colorControlActivated">#00686C</item>
        <item name="android:colorButtonNormal">#EDF4F7</item>
        <item name="android:alertDialogTheme">@style/AppDialogTheme</item>
    </style>
    <style name="AppDialogTheme" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#00686C</item>
        <item name="android:colorControlActivated">#00686C</item>
        <item name="android:colorControlNormal">#425B70</item>
        <item name="android:colorBackground">#EDF3F7</item>
        <item name="android:colorBackgroundFloating">#FCFDFF</item>
        <item name="android:textColorPrimary">#102438</item>
        <item name="android:textColorSecondary">#425B70</item>
    </style>
</resources>
