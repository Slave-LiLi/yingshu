<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">#091221</item>
        <item name="android:navigationBarColor">#091221</item>
        <item name="android:windowBackground">#091221</item>
        <item name="android:colorBackground">#091221</item>
        <item name="android:colorBackgroundFloating">#121F33</item>
        <item name="android:textColorPrimary">#EDF6FF</item>
        <item name="android:textColorSecondary">#A4B6CA</item>
        <item name="android:colorAccent">#81EBDD</item>
        <item name="android:colorControlNormal">#A4B6CA</item>
        <item name="android:colorControlActivated">#81EBDD</item>
        <item name="android:colorButtonNormal">#1C3148</item>
        <item name="android:alertDialogTheme">@style/AppDialogTheme</item>
    </style>
    <style name="AppDialogTheme" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#81EBDD</item>
        <item name="android:colorControlActivated">#81EBDD</item>
        <item name="android:colorControlNormal">#A4B6CA</item>
        <item name="android:colorBackground">#091221</item>
        <item name="android:colorBackgroundFloating">#121F33</item>
        <item name="android:textColorPrimary">#EDF6FF</item>
        <item name="android:textColorSecondary">#A4B6CA</item>
    </style>
</resources>
