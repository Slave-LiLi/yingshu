<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:statusBarColor">#0D0A11</item>
        <item name="android:navigationBarColor">#0D0A11</item>
        <item name="android:windowBackground">#0D0A11</item>
        <item name="android:colorBackground">#0D0A11</item>
        <item name="android:colorBackgroundFloating">#19141F</item>
        <item name="android:textColorPrimary">#F5EFFA</item>
        <item name="android:textColorSecondary">#C0B2CC</item>
        <item name="android:colorAccent">#C8A0FF</item>
        <item name="android:colorControlNormal">#C0B2CC</item>
        <item name="android:colorControlActivated">#C8A0FF</item>
        <item name="android:colorControlHighlight">#30C8A0FF</item>
        <item name="android:textColorHighlight">#4DC8A0FF</item>
        <item name="android:textColorLink">#D4B2FF</item>
        <item name="android:colorButtonNormal">#2A2034</item>
        <item name="android:alertDialogTheme">@style/AppDialogTheme</item>
    </style>
    <style name="AppDialogTheme" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#C8A0FF</item>
        <item name="android:colorControlActivated">#C8A0FF</item>
        <item name="android:colorControlHighlight">#30C8A0FF</item>
        <item name="android:textColorHighlight">#4DC8A0FF</item>
        <item name="android:textColorLink">#D4B2FF</item>
        <item name="android:colorControlNormal">#C0B2CC</item>
        <item name="android:colorBackground">#0D0A11</item>
        <item name="android:colorBackgroundFloating">#19141F</item>
        <item name="android:textColorPrimary">#F5EFFA</item>
        <item name="android:textColorSecondary">#C0B2CC</item>
    </style>
</resources>
